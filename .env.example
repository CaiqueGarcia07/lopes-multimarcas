# -----------------------------------------------------------------------------
# Supabase (envio real da ficha — opção recomendada)
# Copie este arquivo para .env.local e preencha com os valores do painel:
# Project Settings > API > Project URL / anon public key
# Quando preenchidos, têm prioridade sobre a VITE_PROPOSAL_API_URL abaixo.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL completa de um webhook alternativo (usada apenas sem o Supabase acima).
VITE_PROPOSAL_API_URL=https://api.exemplo.com/propostas

# true: simula um envio quando nenhum destino estiver configurado.
# false: exige um destino real.
VITE_DEMO_MODE=true
